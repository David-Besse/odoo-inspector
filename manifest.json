{
  "manifest_version": 3,
  "name": "Odebug",
  "description": "Odoo debug mode manager for developers",
  "author": "David B.",
  "minimum_chrome_version": "102",
  "permissions": [
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "img/icons/icon16_gray.png",
      "48": "img/icons/icon48_gray.png",
      "128": "img/icons/icon128_gray.png"
    },
    "default_title": "Odebug"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "icons": {
    "16": "img/icons/icon16.png",
    "48": "img/icons/icon48.png",
    "128": "img/icons/icon128.png"
  }
}
